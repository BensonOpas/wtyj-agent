# Mermaid TRACY platform.env template.
# Copy to /root/clients/mermaid/config/platform.env on the VPS, fill secrets
# there, and keep the live file mode at 0600. Never commit real values.

TENANT_ID=mermaid
TENANT_SLUG=mermaid
TENANT_ACCOUNT_ALLOWLIST_REQUIRED=true
TENANT_RUNTIME_CONTROLS_REQUIRED=true

# Anthropic
ANTHROPIC_API_KEY=

# Unboks dashboard
DASHBOARD_PASSWORD=

# Nr3 tenant-scoped bridge
NR3_INTERNAL_OVERRIDES_URL=http://wtyj-admin:8010
NR3_INTERNAL_API_TOKEN=
ICP_OVERRIDES_TTL_SECONDS=5

# Zernio shared transport. Tenant isolation is enforced by the strict account
# allowlist in the protected live client.json. The tracked template is
# strict-empty so checkouts cannot bind to the live account.
LATE_API_KEY=
ZERNIO_WEBHOOK_SECRET=

# Direct Meta delivery stays disabled. Zernio is the only provider path.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
META_APP_ID=
META_APP_SECRET=
