# Add inside the existing HTTPS unboks.org server block.
# BEGIN MERMAID SHORT CHECKOUT
location ^~ /mermaid/pay/ {
    proxy_pass http://127.0.0.1:8102/pay/;
    proxy_set_header X-Tenant-Slug mermaid;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_hide_header X-Unboks-Tenant;
    add_header X-Unboks-Tenant "mermaid" always;
    access_log off;
}
# END MERMAID SHORT CHECKOUT
